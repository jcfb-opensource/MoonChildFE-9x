{
  "version": 4,
  "configurePresets": [
    {
      "name": "win98-debug",
      "generator": "MinGW Makefiles",
      "toolchainFile": "${sourceDir}/CMake/Toolchains/Win98MinGW.cmake",
      "binaryDir": "${sourceDir}/CMakeOut/Win98/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-Og -g",
        "CMAKE_CXX_FLAGS_DEBUG": "-Og -g"
      }
    },
    {
      "name": "win98-release",
      "generator": "MinGW Makefiles",
      "toolchainFile": "${sourceDir}/CMake/Toolchains/Win98MinGW.cmake",
      "binaryDir": "${sourceDir}/CMakeOut/Win98/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -fomit-frame-pointer",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -fomit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-win98-debug",
      "configurePreset": "win98-debug"
    },
    {
      "name": "build-win98-release",
      "configurePreset": "win98-release"
    }
  ]
}
