{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Game (Win98)",
            "type": "node-terminal",
            "request": "launch",
            "preLaunchTask": "Build Game (Win98, Debug)",
            "command": "powershell.exe -NoProfile -Command \"Set-Location -LiteralPath '${workspaceFolder}/Bin/Win98'; & '.\\Moon Child FE.exe'\"",
        },
        {
            "name": "Run Game (Win98)",
            "type": "node-terminal",
            "request": "launch",
            "preLaunchTask": "Build Game (Win98, Release)",
            "command": "powershell.exe -NoProfile -Command \"Set-Location -LiteralPath '${workspaceFolder}/Bin/Win98'; & '.\\Moon Child FE.exe'\"",
        },
    ]
}
